# Port the Uvicorn server listens on.
PORT=5200

# Set to "production" to restrict CORS to the allow-list only. Any other value (the default
# when unset is "development") additionally permits http(s)://localhost[:port] origins so the
# local frontend can call this API. Deployments MUST set this to "production".
ENVIRONMENT=production

# Comma-separated list of additional CORS origins to allow, beyond https://regextester.github.io.
ALLOW_CORS=

# Optional Cosmos DB telemetry settings. An empty COSMOS_ENDPOINT silently disables telemetry
# (the normal local-development state). Authentication is Entra ID via DefaultAzureCredential --
# the App Service managed identity in Azure, or your `az login` session locally -- so there is no
# account key here. The identity needs the Cosmos DB Built-in Data Contributor data-plane role,
# and the container must already exist (see DEPLOYMENT.md section 2).
COSMOS_ENDPOINT=
COSMOS_DATABASE=regex-tester-db
COSMOS_CONTAINER=telemetry
