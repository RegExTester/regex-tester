{
  "openapi": "3.0.1",
  "info": {
    "title": "RegEx Tester API",
    "description": "REST API for testing Java regular expressions using java.util.regex.",
    "version": "1.0"
  },
  "servers": [
    {
      "url": "http://localhost:5300",
      "description": "Generated server url"
    }
  ],
  "paths": {
    "/api/regex": {
      "post": {
        "tags": [
          "RegEx"
        ],
        "summary": "Run a regular expression against input text",
        "operationId": "post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Input"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Match results. Regex errors and both timeouts are also reported here, via the `error` field — never as an HTTP error status.",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/RegexResult"
                }
              }
            }
          },
          "400": {
            "description": "A field exceeded its maximum length",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            }
          },
          "413": {
            "description": "Raw request body exceeded maxRequestBodyBytes (8192)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/capabilities": {
      "get": {
        "tags": [
          "Capabilities"
        ],
        "summary": "Report engine identity and the options, limits, and features this engine supports",
        "operationId": "capabilities",
        "responses": {
          "200": {
            "description": "Capability document (cacheable for 24 hours)",
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Home"
        ],
        "summary": "Redirect to the frontend",
        "operationId": "root",
        "responses": {
          "302": {
            "description": "Redirect to https://regextester.github.io/"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Input": {
        "type": "object",
        "properties": {
          "pattern": {
            "maxLength": 512,
            "minLength": 0,
            "type": "string"
          },
          "text": {
            "maxLength": 1024,
            "minLength": 0,
            "type": "string"
          },
          "replace": {
            "maxLength": 1024,
            "minLength": 0,
            "type": "string"
          },
          "options": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetailsResponse": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "CaptureResult": {
        "type": "object",
        "properties": {
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "length": {
            "type": "integer",
            "format": "int32"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "GroupResult": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "length": {
            "type": "integer",
            "format": "int32"
          },
          "value": {
            "type": "string"
          },
          "captures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CaptureResult"
            }
          }
        }
      },
      "MatchResult": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "index": {
            "type": "integer",
            "format": "int32"
          },
          "length": {
            "type": "integer",
            "format": "int32"
          },
          "value": {
            "type": "string"
          },
          "groups": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GroupResult"
            }
          },
          "captures": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CaptureResult"
            }
          }
        }
      },
      "RegexResult": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "replace": {
            "type": "string"
          },
          "matches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MatchResult"
            }
          }
        }
      },
      "Capabilities": {
        "type": "object",
        "properties": {
          "engineKey": {
            "type": "string"
          },
          "engineName": {
            "type": "string"
          },
          "contractVersion": {
            "type": "string"
          },
          "runtime": {
            "$ref": "#/components/schemas/Runtime"
          },
          "defaultOptions": {
            "type": "integer",
            "format": "int32"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          },
          "features": {
            "$ref": "#/components/schemas/Features"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CapabilityOption"
            }
          }
        }
      },
      "CapabilityOption": {
        "type": "object",
        "properties": {
          "value": {
            "type": "integer",
            "format": "int32"
          },
          "name": {
            "type": "string"
          },
          "flag": {
            "type": "string"
          },
          "supported": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "Features": {
        "type": "object",
        "properties": {
          "replace": {
            "type": "boolean"
          },
          "namedGroups": {
            "type": "boolean"
          },
          "captures": {
            "type": "string"
          }
        }
      },
      "Limits": {
        "type": "object",
        "properties": {
          "patternMaxLength": {
            "type": "integer",
            "format": "int32"
          },
          "textMaxLength": {
            "type": "integer",
            "format": "int32"
          },
          "replaceMaxLength": {
            "type": "integer",
            "format": "int32"
          },
          "regexTimeoutMs": {
            "type": "integer",
            "format": "int32"
          },
          "requestTimeoutMs": {
            "type": "integer",
            "format": "int32"
          },
          "maxRequestBodyBytes": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Runtime": {
        "type": "object",
        "properties": {
          "os": {
            "type": "string"
          },
          "framework": {
            "type": "string"
          }
        }
      }
    }
  }
}
