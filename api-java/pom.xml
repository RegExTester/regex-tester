<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.4.1</version>
    <relativePath/>
  </parent>

  <groupId>io.github.regextester</groupId>
  <artifactId>regex-tester-api-java</artifactId>
  <version>1.0.0</version>
  <name>RegEx Tester API (Java)</name>
  <description>REST API for testing Java regular expressions using java.util.regex.</description>

  <properties>
    <!-- Java 21 is a hard requirement, not a preference: RegexProcessor uses
         Pattern.namedGroups(), which was added in Java 20. -->
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <springdoc.version>2.7.0</springdoc.version>
    <azure.cosmos.version>4.65.0</azure.cosmos.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- Bean Validation, backing the pattern/text/replace maxLength checks that must
         surface as HTTP 400 RFC 9457 ProblemDetails. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Serves the OpenAPI document at /openapi/v1.json and the explorer at /scalar/v1
         (paths configured in application.properties). -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Optional telemetry sink. Never required at runtime: an empty
         COSMOS_CONNECTION_STRING disables telemetry silently. -->
    <dependency>
      <groupId>com.azure</groupId>
      <artifactId>azure-cosmos</artifactId>
      <version>${azure.cosmos.version}</version>
    </dependency>
  </dependencies>

  <build>
    <!-- Azure App Service's Java SE runtime runs `java -jar app.jar` by default, so naming
         the artifact `app` means the deploy workflow needs no startup-command override. -->
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
